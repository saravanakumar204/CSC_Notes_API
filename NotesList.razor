@page "/notesList"
@using CSC_NotesService.Models
@inject NotesContext Context

<h3>Product List</h3>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in Context.Notes)
        {
            <tr>
                <td>@note.Type</td>
                <td>@note.Description</td>
                <td>
                    <button @onclick="() => EditNote(note.NotesId)">Edit</button>
                    <button @onclick="() => DeleteNote(note.NotesId)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3>Add/Edit Product</h3>
<input @bind="currentProduct.Name" placeholder="Name" />
<input @bind="currentProduct.Price" placeholder="Price" />
<button @onclick="SaveProduct">Save</button>

